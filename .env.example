# Required
ANTHROPIC_API_KEY=sk-ant-...

# Optional — everything below has sensible defaults
ROUTING_STRATEGY=cascade                        # or "three_phase"
CONFIDENCE_THRESHOLD=0.80                       # cascade escalation threshold
SELECTOR_MODEL_DEFAULT=claude-haiku-4-5-20251001
SELECTOR_MODEL_ESCALATION=claude-sonnet-4-6
CLASSIFIER_MODEL=claude-haiku-4-5-20251001
NL2SQL_MODEL=claude-sonnet-4-6
# Any model setting may be "gemini:<model>" instead (needs GEMINI_API_KEY), e.g.
# NL2SQL_MODEL=gemini:gemini-flash-latest
# SELECTOR_MODEL_DEFAULT=gemini:gemini-3.1-flash-lite
# SELECTOR_MODEL_ESCALATION=gemini:gemini-flash-latest
# GEMINI_API_KEY=...
# GEMINI_REASONING_EFFORT=low                   # "" = omit (model default)
# RUNTIME_SETTINGS_ENABLED=1                    # POST /settings/runtime (never on a public host)
ENABLE_THINKING_ON_ESCALATION=false
DB_URL=sqlite:///./pantry.db
MCP_HTTP_ENABLED=true                           # serve MCP at /mcp on the API (no auth!)
# BURR_TRACKING_DIR=~/.pantry-planner/burr      # where Burr traces land (stdio MCP default)
# TRUSTED_PROXY_HOPS=1                          # proxies appending X-Forwarded-For (0 = ignore it)
# LLM_DAILY_COST_CAP_USD=5                      # 503 on LLM endpoints above this spend per UTC day
# OFFERS_SYNTHETIC=true                         # store prices, stock and reviews are demo data (labelled)
# Product matching by meaning (pantry_planner/matching): the local Ollama that embeds an
# ingredient name no seed knows; empty = off (such names are matched by words)
# OLLAMA_URL=http://127.0.0.1:11434
# EMBEDDING_MODEL=embeddinggemma                 # or gemini:gemini-embedding-001 (GEMINI_API_KEY),
#                                               # which reads seeds/gemini_vectors.json instead
# DESCRIBER_MODEL=gemini:gemini-3.1-flash-lite  # identifies a name no seed knows first; "" = off
# MATCHING_DAILY_EMBED_TEXTS=900                # the matcher's daily allowances of model requests,
# MATCHING_DAILY_DESCRIBE_CALLS=200             # counted across instances in the database; 0 = none
# PANTRY_DATA_DIR=~/.pantry-data                # embedding cache + matching/events.jsonl
# MATCHING_EVENTS=1                             # 0 = no shown/picked log
